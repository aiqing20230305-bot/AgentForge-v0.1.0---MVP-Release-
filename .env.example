# SeeDream 5.0 配置
SEEDREAM_API_KEY=your_seedream_api_key_here
SEEDREAM_BASE_URL=https://api.seedream.ai/v1
SEEDREAM_MODEL=seedream-5.0

# SeeDance 1.5 配置
SEEDANCE_API_KEY=your_seedance_api_key_here
SEEDANCE_BASE_URL=https://api.seedance.ai/v1
SEEDANCE_MODEL=seedance-1.5

# 生成配置
GENERATION_DELAY_MS=3000        # 每次生成之间的延迟（毫秒）
MAX_RETRIES=3                   # 失败重试次数
IMAGE_WIDTH=768                 # 9:16 图片宽度
IMAGE_HEIGHT=1344               # 9:16 图片高度
VIDEO_WIDTH=576                 # 9:16 视频宽度
VIDEO_HEIGHT=1024               # 9:16 视频高度
VIDEO_FPS=30                    # 视频帧率
VIDEO_DURATION_SECONDS=4        # 视频时长
