# AgentForge Backend Environment Variables
# 复制此文件为 .env 并填入实际值

# Environment
NODE_ENV=development

# Server
PORT=3001

# MongoDB Connection
# 本地开发
MONGODB_URI=mongodb://localhost:27017/agentforge
MONGODB_TEST_URI=mongodb://localhost:27017/agentforge_test

# JWT Authentication
# ⚠️ 生产环境必须更换为强随机密钥！
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=REPLACE_WITH_YOUR_STRONG_SECRET_KEY_HERE
JWT_REFRESH_SECRET=REPLACE_WITH_YOUR_STRONG_REFRESH_SECRET_HERE
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# OAuth (可选)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 安全提醒：
# - 所有*_SECRET, *_KEY, *_PASSWORD 都应该使用强随机值
# - 永远不要提交真实凭证到Git
# - 生产环境使用不同的密钥
